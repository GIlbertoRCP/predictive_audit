# Opt-in sanitizers: -DPAUDIT_SANITIZE=address,undefined
function(paudit_enable_sanitizers target)
  if(PAUDIT_SANITIZE STREQUAL "")
    return()
  endif()
  if(MSVC)
    if(PAUDIT_SANITIZE MATCHES "address")
      target_compile_options(${target} PRIVATE /fsanitize=address)
    endif()
    return()
  endif()
  set(_flags -fsanitize=${PAUDIT_SANITIZE} -fno-omit-frame-pointer -fno-sanitize-recover=all)
  target_compile_options(${target} PRIVATE ${_flags})
  target_link_options(${target} PRIVATE ${_flags})
endfunction()
